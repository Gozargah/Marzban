{
  "log": {
    "access": "/var/lib/marzban/access.log",
    "error": "/var/lib/marzban/error.log",
    "loglevel": "warning",
    "dnsLog": true
  },
  "dns": {
    "servers": [
      "1.1.1.1",
      "8.8.8.8"
    ],
    "queryStrategy": "UseIPv4"
  },
  "routing": {
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "BLOCK"
      },
      {
        "type": "field",
        "inboundTag": [
          "SOCKS5_INBOUND"
        ],
        "outboundTag": "DIRECT"
      },
      {
        "outboundTag": "WARP",
        "domain": [
          "domain:gemini.google.com",
          "domain:aistudio.google.com",
          "domain:labs.google.com"
        ],
        "type": "field"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "VLESS TCP REALITY",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "tcpSettings": {},
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "127.0.0.1:8443",
          "xver": 1,
          "serverNames": [
            "nider.the-tech.studio",
            "ger.the-tech.studio",
            "us.the-tech.studio",
            "tr.the-tech.studio",
            "rus.the-tech.studio",
            "ozon.ru"
          ],
          "privateKey": "MM9IB96Umr5nTrY_1aCtCV0xWbf6txq5OqAVHSNwaDE",
          "publicKey": "FxBXajlaqEPVKi0y9xmVImnHyU4wD-Utdvt4uwS-jGY",
          "shortIds": [
            "6ba85179e30d4fc2"
          ]
        },
        "flow": "xtls-rprx-vision"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "VLESS-XHTTP-REALITY",
      "listen": "0.0.0.0",
      "port": 80,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "api.events.plus.yandex.net:443",
          "serverNames": [
            "api.events.plus.yandex.net"
          ],
          "privateKey": "0HB1kbz-GPHPsSa1PR8_ii36uC3C5tJfp6uXVZsJED0",
          "publicKey": "VMExiTnaqxU2_lH8TwqJUX7bteJUI7ULWzgsFZGOQgM",
          "minClientVer": "",
          "maxClientVer": "",
          "maxTimeDiff": 0,
          "shortIds": [
            "6ba85179e30d4fc2",
            "a1b2c3d4",
            "e5f67890"
          ],
          "spiderX": "/"
        },
        "xhttpSettings": {
          "path": "/",
          "host": "api.events.plus.yandex.net",
          "scMaxBufferedPosts": 30,
          "scMaxEachPostBytes": 1000000,
          "scStreamUpServerSecs": "20-80",
          "noSSEHeader": false,
          "xPaddingBytes": "100-1000",
          "mode": "auto"
        },
        "tlsSettings": {
          "fingerprint": "chrome",
          "serverName": "api.events.plus.yandex.net",
          "alpn": [
            "h2",
            "http/1.1"
          ],
          "minVersion": "1.2",
          "maxVersion": "1.3"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "HYSTERIA2",
      "listen": "0.0.0.0",
      "port": 2083,
      "protocol": "hysteria",
      "settings": {
        "clients": []
      },
      "streamSettings": {
        "network": "hysteria",
        "security": "tls",
        "hysteriaSettings": {
          "version": 2,
          "up": "100 mbps",
          "down": "200 mbps",
          "congestion": "brutal",
          "ignoreClientBandwidth": false
        },
        "tlsSettings": {
          "certificates": [
            {
              "certificateFile": "/var/lib/marzban/certs/fullchain.pem",
              "keyFile": "/var/lib/marzban/certs/key.pem"
            }
          ],
          "alpn": ["h3"]
        }
      }
    },
    {
      "tag": "SOCKS5_INBOUND",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "password",
        "udp": true,
        "accounts": []
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "DIRECT"
    },
    {
      "protocol": "blackhole",
      "tag": "BLOCK"
    },
    {
      "tag": "WARP",
      "protocol": "wireguard",
      "settings": {
        "secretKey": "COPXC+OUwjo49lVRdxf7S/nYAVXCVtqH/wYJ9+b0KHI=",
        "DNS": "1.1.1.1",
        "address": [
          "172.16.0.2/32",
          "2606:4700:110:8381:7328:468f:78ff:a1f5/128"
        ],
        "peers": [
          {
            "publicKey": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
            "endpoint": "engage.cloudflareclient.com:2408"
          }
        ],
        "kernelMode": false
      }
    }
  ]
}
