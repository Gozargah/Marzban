{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "browser": true
  },
  "overrides": [
    {
      "files": ["test/**/*.cjs", "test/**/*.ts", "test/**/*.tsx", "scripts/**/*.ts", "vite.config.ts"],
      "env": { "node": true },
      "globals": { "Bun": "readonly" }
    }
  ]
}
