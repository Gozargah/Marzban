# Hysteria2 server configuration
# Place this file on your server at: /var/lib/marzban/hysteria.yaml
#
# SETUP STEPS:
# 1. Generate a random token:
#      openssl rand -hex 32
# 2. Add to /opt/marzban/.env:
#      HYSTERIA2_HOOK_TOKEN=<token from step 1>
# 3. Replace YOUR_TOKEN_HERE below with the same token
# 4. Replace YOUR_DOMAIN with your actual domain
# 5. Run: marzban restart

listen: :2087

tls:
  cert: /certs/fullchain.pem
  key: /certs/key.pem

auth:
  type: http
  http:
    # Marzban auth hook — hysteriad calls this on every new client connection.
    url: http://127.0.0.1:8000/api/hysteria/auth?token=YOUR_TOKEN_HERE
    insecure: false
    timeout: 10s

masquerade:
  type: proxy
  proxy:
    url: https://YOUR_DOMAIN
    rewriteHost: true

bandwidth:
  up: 100 mbps
  down: 200 mbps

# Traffic stats API — Marzban polls this to record usage and online status.
trafficStats:
  listen: 127.0.0.1:9999
  secret: YOUR_TRAFFIC_SECRET_HERE

# ─── QUIC tuning for mobile networks (RU: MTS, Beeline, Megafon, Tele2) ────────
#
# Problem: Russian mobile operators use aggressive CGNAT with short UDP idle
# timeouts (30–60s). High RTT to foreign servers (USA, Turkey) makes QUIC
# sessions drop before the client can send the next packet.
#
# Fix:
#   keepAlivePeriod — server sends a QUIC PING frame every N seconds.
#     This resets the CGNAT UDP session timer on the operator side AND resets
#     the idle timeout for awake clients — so active connections live forever.
#     10s is well under any known CGNAT UDP timeout (30–60s).
#
#   maxIdleTimeout — how long the server waits before closing an idle connection.
#     30s: only triggers when the client stops responding to PINGs (phone asleep).
#     On wake the server immediately sends STATELESS_RESET → client reconnects fast.
#
#   initStreamReceiveWindow / initConnReceiveWindow — QUIC flow control windows.
#     Smaller values (8 MB / 20 MB) reduce memory pressure and play better
#     with congested mobile uplinks compared to the 26 MB / 67 MB defaults.
quic:
  initStreamReceiveWindow: 8388608   # 8 MB (default: 26 MB)
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520    # 20 MB (default: 67 MB)
  maxConnReceiveWindow: 20971520
  maxIdleTimeout: 30s                # fires only when client ignores PINGs (asleep)
  keepAlivePeriod: 10s               # PING every 10s — keeps CGNAT + idle timer alive
  disablePathMTUDiscovery: true      # use fixed MTU instead of auto-discovery

# Fixed MTU avoids QUIC PMTUD probes that mobile operators sometimes drop.
# 1400 safely fits inside any link without fragmentation.
sniff:
  enable: false

transport:
  udp:
    mtu: 1400
