{
  "log": {
    "access": "/var/lib/marzban/access.log",
    "error": "/var/lib/marzban/error.log",
    "loglevel": "INFO"
  },
  "dns": {
    "servers": [
      "1.1.1.1",
      "8.8.8.8"
    ],
    "queryStrategy": "UseIPv4"
  },
  "routing": {
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "BLOCK"
      },
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "BLOCK"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "port": "6881-6999,51413,6969,16384-16403,49152-65535",
        "outboundTag": "BLOCK"
      },
      {
        "type": "field",
        "domain": [
          "regexp:.*(announce|scrape|tracker|torrent|bt|magnet).*"
        ],
        "outboundTag": "BLOCK"
      },
      {
        "type": "field",
        "inboundTag": [
          "SOCKS5_INBOUND"
        ],
        "outboundTag": "DIRECT"
      },
      {
        "outboundTag": "WARP",
        "domain": [
          "domain:gemini.google.com",
          "domain:aistudio.google.com",
          "domain:labs.google.com"
        ],
        "type": "field"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "HYSTERIA2",
      "listen": "0.0.0.0",
      "port": 2087,
      "protocol": "hysteria",
      "settings": {
        "clients": []
      },
      "streamSettings": {
        "network": "hysteria",
        "security": "tls",
        "hysteriaSettings": {
          "version": 2,
          "up": "500mbps",
          "down": "500mbps",
          "congestion": "brutal",
          "ignoreClientBandwidth": true
        },
        "tlsSettings": {
          "serverName": "config.the-tech.studio",
          "certificates": [
            {
              "certificateFile": "/var/lib/marzban/certs/fullchain.pem",
              "keyFile": "/var/lib/marzban/certs/key.pem"
            }
          ],
          "alpn": [
            "h3"
          ]
        },
        "udpmasks": []
      }
    },
    {
      "tag": "VLESS XHTTP REALITY",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "mode": "stream-one",
          "path": "/",
          "scMaxBufferedPosts": 30,
          "scMaxEachPostBytes": 1000000,
          "scStreamUpServerSecs": "20-80",
          "xPaddingBytes": "100-1400",
          "noSSEHeader": false
        },
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "api.events.plus.yandex.net:443",
          "xver": 0,
          "serverNames": [
            "api.events.plus.yandex.net",
            "www.microsoft.com",
            "microsoft.com",
            "ozon.ru"
          ],
          "privateKey": "0Az88Phemm2ZV65zb8GF5Rn__V1GSX6Cc61XhIVJA38",
          "publicKey": "RDfUMM97vloh-gEEqEoiksNM-6lePmwAE-SlYakCgC4",
          "fingerprint": "chrome",
          "shortIds": [
            "6ba85179e30d4fc2",
            "a1b2c3d4",
            "e5f67890",
            "f9a8b7c6",
            ""
          ],
          "spiderX": "/"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "SOCKS5_INBOUND",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "password",
        "udp": true,
        "accounts": []
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "DIRECT"
    },
    {
      "protocol": "blackhole",
      "tag": "BLOCK"
    },
    {
      "tag": "WARP",
      "protocol": "wireguard",
      "settings": {
        "secretKey": "COPXC+OUwjo49lVRdxf7S/nYAVXCVtqH/wYJ9+b0KHI=",
        "DNS": "1.1.1.1",
        "address": [
          "172.16.0.2/32",
          "2606:4700:110:8381:7328:468f:78ff:a1f5/128"
        ],
        "peers": [
          {
            "publicKey": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
            "endpoint": "engage.cloudflareclient.com:2408"
          }
        ],
        "kernelMode": false
      }
    }
  ]
}