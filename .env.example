UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000
## Browser origins allowed to call the API from another site. Empty by default:
## the dashboard is served from the same origin and needs no CORS. Only set this
## if you host a frontend elsewhere, and list exact origins — '*' cannot carry
## the session cookie, browsers reject a wildcard with credentials.
# ALLOWED_ORIGINS=https://panel.example.com,https://admin.example.com

## We highly recommend add admin using `xenith cli` tool and do not use
## the following variables which is somehow hard codded infrmation.
# SUDO_USERNAME = "admin"
# SUDO_PASSWORD = "admin"

# UVICORN_UDS = "/run/marzban.socket"
# UVICORN_SSL_CERTFILE = "/var/lib/marzban/certs/example.com/fullchain.pem"
# UVICORN_SSL_KEYFILE = "/var/lib/marzban/certs/example.com/key.pem"
# UVICORN_SSL_CA_TYPE = "public"

# DASHBOARD_PATH = "/dashboard/"

# XRAY_JSON = "xray_config.json"
# XRAY_SUBSCRIPTION_URL_PREFIX = "https://example.com"
# XRAY_SUBSCRIPTION_PATH = "sub"
# XRAY_EXECUTABLE_PATH = "/usr/local/bin/xray"
# XRAY_ASSETS_PATH = "/usr/local/share/xray"
# XRAY_EXCLUDE_INBOUND_TAGS = "INBOUND_X INBOUND_Y"
# XRAY_FALLBACKS_INBOUND_TAG = "INBOUND_X"


# TELEGRAM_API_TOKEN = 123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# TELEGRAM_ADMIN_ID = 987654321, 123456789
# TELEGRAM_LOGGER_CHANNEL_ID = -1234567890123
# TELEGRAM_LOGGER_TOPIC_ID = 0
# TELEGRAM_DEFAULT_VLESS_FLOW = "xtls-rprx-vision"
# TELEGRAM_PROXY_URL = "http://localhost:8080"

# DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/xxxxxxx"
## Seconds to wait on one Discord delivery. Reports are sent from the thread
## serving the request that triggered them, so this is what keeps a webhook
## that never answers from holding that thread. Default 10.
# DISCORD_WEBHOOK_TIMEOUT = 10

# CUSTOM_TEMPLATES_DIRECTORY="/var/lib/marzban/templates/"
# CLASH_SUBSCRIPTION_TEMPLATE="clash/my-custom-template.yml"
# CLASH_SETTINGS_TEMPLATE="clash/settings.yml"
# SUBSCRIPTION_PAGE_TEMPLATE="subscription/index.html"
# HOME_PAGE_TEMPLATE="home/index.html"

# V2RAY_SUBSCRIPTION_TEMPLATE="v2ray/default.json"
# V2RAY_SETTINGS_TEMPLATE="v2ray/settings.json"

# SINGBOX_SUBSCRIPTION_TEMPLATE="singbox/default.json"
# SINGBOX_SETTINGS_TEMPLATE="singbox/settings.json"

# MUX_TEMPLATE="mux/default.json"

## Random user agents offered to clients that ask for one.
# USER_AGENT_TEMPLATE="user_agent/default.json"
# GRPC_USER_AGENT_TEMPLATE="user_agent/grpc.json"

## Enable JSON config for compatible clients to use mux, fragment, etc. Default False.
# USE_CUSTOM_JSON_DEFAULT=True
## Your preferred config type for different clients
## If USE_CUSTOM_JSON_DEFAULT is set True, all following programs will use the JSON config
# USE_CUSTOM_JSON_FOR_V2RAYN=False
# USE_CUSTOM_JSON_FOR_V2RAYNG=True
# USE_CUSTOM_JSON_FOR_STREISAND=False
# USE_CUSTOM_JSON_FOR_HAPP=False
# USE_CUSTOM_JSON_FOR_NPVTUNNEL=False

## Set headers for subscription
# SUB_PROFILE_TITLE = "Susbcription"
# SUB_SUPPORT_URL = "https://t.me/support"
# SUB_UPDATE_INTERVAL = "12"

## External config to import into v2ray format subscription
# EXTERNAL_CONFIG = "config://..."

# SQLALCHEMY_DATABASE_URL = "sqlite:///db.sqlite3"
# SQLALCHEMY_POOL_SIZE = 10
# SQLIALCHEMY_MAX_OVERFLOW = 30

## Custom text for STATUS_TEXT variable
# ACTIVE_STATUS_TEXT = "Active"
# EXPIRED_STATUS_TEXT = "Expired"
# LIMITED_STATUS_TEXT = "Limited"
# DISABLED_STATUS_TEXT = "Disabled"
# ONHOLD_STATUS_TEXT = "On-Hold"

### Use negative values to disable auto-delete by default
# USERS_AUTODELETE_DAYS = -1
# USER_AUTODELETE_INCLUDE_LIMITED_ACCOUNTS = false

## How many devices may fetch one user's subscription, counted by the hardware
## id their client reports. 0 is off, and off is the default for a reason: with
## a limit in force a client that sends no identifier is refused outright, and
## most clients send none — a browser opening the subscription page included.
## A per-user limit set from the panel overrides this.
# USERS_DEFAULT_HWID_DEVICE_LIMIT = 0
## The header the identifier arrives in. Configurable because it is a client
## convention rather than a standard.
# HWID_HEADER = "x-hwid"

## Customize all notifications
# NOTIFY_STATUS_CHANGE = True
# NOTIFY_USER_CREATED = True
# NOTIFY_USER_UPDATED = True
# NOTIFY_USER_DELETED = True
# NOTIFY_USER_DATA_USED_RESET = True
# NOTIFY_USER_SUB_REVOKED = True
# NOTIFY_IF_DATA_USAGE_PERCENT_REACHED = True
# NOTIFY_IF_DAYS_LEFT_REACHED = True
# NOTIFY_LOGIN = True

## Whitelist of IPs/hosts to disable login notifications
# LOGIN_NOTIFY_WHITE_LIST = '1.1.1.1,127.0.0.1'

## Brute-force protection for /api/admin/token: a client IP that fails this
## many logins within the window gets 429 until the window slides past.
## Set LOGIN_RATE_LIMIT_ATTEMPTS to 0 to turn it off.
# LOGIN_RATE_LIMIT_ATTEMPTS = 5
# LOGIN_RATE_LIMIT_WINDOW = 300

## TLS certificates through certbot, from the Certificates screen. Off by
## default because it lets the panel run certbot on the host; turn it on only
## where the panel runs as root and /etc/letsencrypt is a persistent volume.
## Only HTTP-01 validation is driven from the panel: 'standalone' needs port 80
## free, 'webroot' needs a directory your web server already serves.
# CERTBOT_ENABLED = True
# CERTBOT_EMAIL = 'ops@example.com'
# CERTBOT_WEBROOT = '/var/www/html'
## Let's Encrypt staging: untrusted certificates, much looser rate limits.
# CERTBOT_STAGING = True
# CERTBOT_EXECUTABLE_PATH = 'certbot'
# CERTBOT_TIMEOUT = 180

## nginx, from the Nginx screen. Off by default: the panel edits files under
## /etc/nginx and signals a process outside the container, so the compose file
## has to mount the host's /etc/nginx and share its PID namespace first.
## scripts/install.sh --with-nginx sets all of that up.
# NGINX_ENABLED = True
# NGINX_EXECUTABLE_PATH = 'nginx'
# NGINX_CONF_DIR = '/etc/nginx'
# NGINX_SITES_AVAILABLE = '/etc/nginx/sites-available'
# NGINX_SITES_ENABLED = '/etc/nginx/sites-enabled'
## Where uploaded pages land. Nothing the panel writes leaves this directory.
# NGINX_WEBROOT = '/var/www/html'
# NGINX_LOG_DIR = '/var/log/nginx'
# NGINX_MAX_UPLOAD_BYTES = 5242880
# NGINX_TIMEOUT = 30

## Kernel tuning from the System settings screen. Off by default: it writes
## /proc/sys and one file under /etc/sysctl.d, which a container only reaches
## when it was started privileged.
# SYSCTL_ENABLED = True
# SYSCTL_CONF_PATH = '/etc/sysctl.d/99-xenith.conf'
# SYSCTL_EXECUTABLE_PATH = 'sysctl'
# SYSCTL_TIMEOUT = 30

## Resource limits. The panel always raises its own open file limit as far as
## its hard limit allows, which needs no privilege and no setting here.
## ULIMIT_ENABLED additionally writes the host's limit files; each one needs
## something restarted before it counts, and the panel restarts nothing.
# ULIMIT_ENABLED = True
## What "maximum" means. Capped by fs.nr_open, which is 1048576 by default.
# ULIMIT_TARGET_NOFILE = 1048576
# ULIMIT_LIMITS_CONF_PATH = '/etc/security/limits.d/99-xenith.conf'
# ULIMIT_SYSTEMD_CONF_PATH = '/etc/systemd/system.conf.d/99-xenith.conf'
# ULIMIT_DOCKER_DAEMON_PATH = '/etc/docker/daemon.json'

## Reverse proxies whose X-Forwarded-For / X-Real-IP headers are believed,
## as IPs or CIDRs. Leave empty when clients reach the panel directly: the
## headers are then ignored, so nobody can forge the IP used for login
## notifications and rate limiting. Set this if you run nginx/Caddy in front,
## otherwise every login looks like it came from the proxy itself and the
## login rate limit can no longer tell one client from another.
# TRUSTED_PROXIES = '127.0.0.1,::1'

### for developers
# DOCS=True
# DEBUG=True

# If You Want To Send Webhook To Multiple Server Add Multi Address
# WEBHOOK_ADDRESS = "http://127.0.0.1:9000/,http://127.0.0.1:9001/"
# WEBHOOK_SECRET = "something-very-very-secret"
## Seconds to wait on one webhook delivery before treating it as failed and
## retrying on a later pass. Not RECURRENT_NOTIFICATIONS_TIMEOUT, which is
## the delay between those retries. Default 10.
# WEBHOOK_REQUEST_TIMEOUT = 10
## How many times a webhook delivery is retried after a failure, and how many
## seconds to wait between those retries.
# NUMBER_OF_RECURRENT_NOTIFICATIONS = 3
# RECURRENT_NOTIFICATIONS_TIMEOUT = 180
# NOTIFY_DAYS_LEFT=3,7
# NOTIFY_REACHED_USAGE_PERCENT=80,90

# VITE_BASE_API="https://example.com/api/"
## How long an admin session lasts. 0 means the token never expires, which
## leaves a leaked one valid until that admin's password is changed; set it
## that way only for an API client that needs a token with no end date.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440

## Accept subscription tokens issued before the HMAC signature change. Those
## carry a 60-bit truncated hash rather than a full HMAC, so this is meant as
## a migration window, not a permanent setting. The panel already hands out
## links in the current format: give your users the link shown on their row,
## then set this to false, which invalidates every older link at once. The log
## says once per restart when an old link is used, so a quiet log after a few
## days of uptime means everyone has moved over.
# ACCEPT_LEGACY_SUBSCRIPTION_TOKENS = True

# JOB_CORE_HEALTH_CHECK_INTERVAL = 10
## Stop writing per-node usage rows. The panel still counts each user's
## traffic; what it stops keeping is the per-node breakdown behind the usage
## charts, which is the table that grows fastest on a busy install.
# DISABLE_RECORDING_NODE_USAGE = False

# JOB_RECORD_NODE_USAGES_INTERVAL = 30
# JOB_RECORD_USER_USAGES_INTERVAL = 10
# JOB_REVIEW_USERS_INTERVAL = 10
# JOB_SEND_NOTIFICATIONS_INTERVAL = 30
