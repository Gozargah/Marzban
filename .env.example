## External config to import into v2ray format subscription
# EXTERNAL_CONFIG = "config://..."

# SQLALCHEMY_DATABASE_URL = "sqlite:///db.sqlite3"
# SQLALCHEMY_POOL_SIZE = 10
# SQLIALCHEMY_MAX_OVERFLOW = 30
# SQLALCHEMY_POOL_TIMEOUT = 30

## Recommended for large user bases (e.g. 20k+ active users):
## pool = steady HTTP + xray-pool + sync workers + headroom.
## Also raise Postgres/MySQL max_connections accordingly.
# SQLALCHEMY_POOL_SIZE = 30
# SQLIALCHEMY_MAX_OVERFLOW = 60

## Hard cap on concurrent /users/sync-inbounds workers that simultaneously
## hold a DB connection and do xray gRPC. Keep well below pool+overflow so
## subscriptions and other endpoints keep serving during a sync.
# SYNC_INBOUNDS_MAX_CONCURRENCY = 8
## DB chunk size for the reconciliation phase of sync-inbounds.
# SYNC_INBOUNDS_DB_CHUNK_SIZE = 200

## Custom text for STATUS_TEXT variable
# ACTIVE_STATUS_TEXT = "Active"
# EXPIRED_STATUS_TEXT = "Expired"
# LIMITED_STATUS_TEXT = "Limited"
# DISABLED_STATUS_TEXT = "Disabled"
# ONHOLD_STATUS_TEXT = "On-Hold"

### Use negative values to disable auto-delete by default
# USERS_AUTODELETE_DAYS = -1
# USER_AUTODELETE_INCLUDE_LIMITED_ACCOUNTS = false

## Customize all notifications
# NOTIFY_STATUS_CHANGE = True
# NOTIFY_USER_CREATED = True
# NOTIFY_USER_UPDATED = True
# NOTIFY_USER_DELETED = True
# NOTIFY_USER_DATA_USED_RESET = True
# NOTIFY_USER_SUB_REVOKED = True
# NOTIFY_IF_DATA_USAGE_PERCENT_REACHED = True
# NOTIFY_IF_DAYS_LEFT_REACHED = True
# NOTIFY_LOGIN = True

## Whitelist of IPs/hosts to disable login notifications
# LOGIN_NOTIFY_WHITE_LIST = '1.1.1.1,127.0.0.1'

### for developers
# DOCS=True
# DEBUG=True

# If You Want To Send Webhook To Multiple Server Add Multi Address
# WEBHOOK_ADDRESS = "http://127.0.0.1:9000/,http://127.0.0.1:9001/"
# WEBHOOK_SECRET = "something-very-very-secret"
# NOTIFY_DAYS_LEFT=3,7
# NOTIFY_REACHED_USAGE_PERCENT=80,90
# RECURRENT_NOTIFICATIONS_TIMEOUT = 180
# NUMBER_OF_RECURRENT_NOTIFICATIONS = 3
# DISABLE_RECORDING_NODE_USAGE = False
# DISABLE_RECORDING_NODE_USER_USAGE = False
# NODE_USER_USAGE_RETENTION_DAYS = 0

# VITE_BASE_API="https://example.com/api/"
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440
# Fallback for old /sub/ tokens until keys are stored in panel settings (UI: JWT key tab).
# After alembic copies this into global_settings, edit keys in the dashboard, not here.
# SUBSCRIPTION_LEGACY_SECRET_KEYS = "oldsecret1hex,oldsecret2hex"

# SQLALCHEMY_POOL_TIMEOUT = 30

# JOB_CORE_HEALTH_CHECK_INTERVAL = 10
# JOB_RECORD_NODE_USAGES_INTERVAL = 30

# Суточный NIC для «Использование узлов»: node_hosting_nic_daily (sidecar prometheus_vpn_nodes_sd, PROMETHEUS_URL в боте)
# Период тика учёта трафика, секунды. Он же — потолок точности всех панелей
# «присутствия» на Grafana-дашборде: окно presence_window там обязано быть
# >= JOB_RECORD_USER_USAGES_INTERVAL/60 + буфер (NPVPN-1966).
# Локально 10; на проде — 300.
# JOB_RECORD_USER_USAGES_INTERVAL = 10
# JOB_REVIEW_USERS_INTERVAL = 10
# JOB_SEND_NOTIFICATIONS_INTERVAL = 30
# JOB_CLEANUP_NODE_USER_USAGE_INTERVAL = 3600
# NODE_USER_USAGE_CLEANUP_BATCH_SIZE = 50000

# review job: пороги диагностического лога [review][on_hold][slow], секунды
# SLOW_USER_TOTAL_THRESHOLD = 1.0
# SLOW_STEP_THRESHOLD = 0.5

# XRAY_NODE_CONNECT_STALE_TIMEOUT = 120
# XRAY_NODE_CERT_FETCH_TIMEOUT = 20
# XRAY_NODE_CONNECT_RETRIES = 3
# XRAY_NODE_CONNECT_RETRY_DELAY = 10
# XRAY_NODE_ERROR_RECONNECT_INTERVAL = 60
# XRAY_NODE_MAX_CONCURRENT_CONNECTS = 10
# Сколько нод реально подключаются одновременно (build+POST конфига)
# XRAY_NODE_CONNECT_CONCURRENCY = 4
# XRAY_NODE_REST_PING_TIMEOUT = 5
# XRAY_NODE_REST_INFO_TIMEOUT = 5
# XRAY_NODE_REST_CONNECT_TIMEOUT = 10
# XRAY_NODE_REST_DISCONNECT_TIMEOUT = 10
# XRAY_NODE_REST_START_TIMEOUT = 30
# XRAY_NODE_REST_RESTART_TIMEOUT = 30
# XRAY_NODE_REST_STOP_TIMEOUT = 10
# XRAY_NODE_GRPC_READY_TIMEOUT = 20
# XRAY_NODE_GRPC_READY_RETRIES = 3
# XRAY_NODE_GRPC_READY_RETRY_DELAY = 2
# Логирование
# LOG_LEVEL=INFO
# LOG_FORMAT=text            # text|json
# LOG_DIR=/var/log/app
# LOG_FILE_MAX_SIZE_MB=50
# LOG_FILE_BACKUP_COUNT=10
# LOG_ACCESS_ENABLED=true
# LOG_ACCESS_NOISE_PATHS=/metrics
# LOG_SQL_SLOW_ENABLED=true

## Диагностика памяти по требованию: включает sudo-only ручки GET /api/system/memory/heap
## (снимок живых объектов кучи) и /api/system/memory/trace/* (tracemalloc). Обе операции
## дорогие: обход кучи держит GIL. При выключенном флаге (по умолчанию) ручки не
## регистрируются вовсе (404). Постоянные метрики памяти процесса (RSS, GC, именованные
## пробы структур в /metrics) этим флагом не управляются и работают всегда. Флаг читается
## на импорте — включение/выключение требует рестарта панели.
# MEMORY_PROFILING_ENABLED=False
